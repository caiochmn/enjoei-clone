<% content_for :title, @department.name %>

<nav class="text-sm text-gray-500"><%= link_to "início", root_path, class: "hover:underline" %> / <%= @department.name.downcase %></nav>
<h1 class="mt-2 text-3xl font-bold"><%= @department.name.downcase %></h1>

<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% @department.children.each do |category| %>
    <section id="<%= category.slug %>" class="rounded-xl border border-gray-200 p-5">
      <h2 class="font-semibold"><%= category.name.downcase %></h2>
      <% if category.children.any? %>
        <ul class="mt-2 space-y-1 text-sm text-gray-600">
          <% category.children.each do |subcategory| %>
            <li><%= subcategory.name.downcase %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</div>

<p class="mt-10 rounded-xl border border-dashed border-gray-300 p-6 text-center text-gray-500">
  Os produtos deste departamento aparecem aqui quando o catálogo estiver pronto.
</p>
