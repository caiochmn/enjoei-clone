<% content_for :title, "Entrar" %>

<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-bold">Entrar</h1>
  <p class="mt-1 text-gray-600">Que bom te ver de novo.</p>

  <%= form_with url: session_path, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>

    <div>
      <%= form.label :password, "Senha", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
    </div>

    <div class="flex items-center justify-between">
      <%= form.submit "Entrar", class: "btn-primary" %>
      <%= link_to "Esqueci minha senha", new_password_path, class: "link text-sm" %>
    </div>
  <% end %>

  <p class="mt-8 text-sm text-gray-600">
    Ainda não tem conta? <%= link_to "Cadastre-se", new_registration_path, class: "link" %>
  </p>
</div>
