<% content_for :title, "Criar conta" %>

<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-bold">Criar conta</h1>
  <p class="mt-1 text-gray-600">Com a conta você já ganha uma lojinha para desapegar.</p>

  <%= form_with model: @user, url: registrations_path, class: "mt-6 space-y-5" do |form| %>
    <%= render "shared/form_errors", record: @user %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "input" %>
    </div>

    <div>
      <%= form.label :email_address, class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
      <p class="mt-1 text-xs text-gray-500">No mínimo 8 caracteres.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Criar conta", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-8 text-sm text-gray-600">
    Já tem conta? <%= link_to "Entrar", new_session_path, class: "link" %>
  </p>
</div>
